<!DOCTYPE HTML PUBLIC "-//IETF//DTD HTML//EN">
<html>

<head>
    <meta http-equiv="content-type" content="text/html; charset=UTF-8">
    <meta name="GENERATOR" content="Microsoft FrontPage 4.0">
    <title>記念写真</title>
    <base target="_self">
</head>

<body bgcolor="#CCFFCC">

<p><a name="第３回"></a>　</p>
<div align="center"><center>

<table border="2">
    <caption align="top"><font size="5">第３回（’９４）　於      
    軽井沢７２ゴルフ</font></caption>      
    <tr>      
        <td bgcolor="#FFFFFF"><a href="photos/94bgc0.jpg"><img      
        src="photos/94bgc0_s.jpg" border="0" width="200"      
        height="139"></a></td>      
        <td bgcolor="#FFFFFF">ラウンド前にハイチーズ</td>      
    </tr>      
    <tr>      
        <td align="center" bgcolor="#FFFFFF"><p align="right">妙に笑顔の３人。</p>      
        <p>やっぱりゴルフは楽しいね。</p>      
        </td>      
        <td bgcolor="#FFFFFF"><a href="photos/94bgc4.jpg"><img      
        src="photos/94bgc4_s.jpg" border="0" width="200"      
        height="142"></a></td>      
    </tr>      
    <tr>      
        <td bgcolor="#FFFFFF"><a href="photos/94bgc6.jpg"><img      
        src="photos/94bgc6_s.jpg" border="0" width="200"      
        height="138"></a></td>      
        <td bgcolor="#FFFFFF">このショットの結果は…（笑）</td>      
    </tr>      
    <tr>      
        <td bgcolor="#FFFFFF">ラウンド中に「ハイ、チーズ！」</td>      
        <td bgcolor="#FFFFFF"><a href="photos/94bgc7.jpg"><img      
        src="photos/94bgc7_s.jpg" border="0" width="200"      
        height="143"></a></td>      
    </tr>      
    <tr>      
        <td bgcolor="#FFFFFF"><a href="photos/94bgc1.jpg"><img      
        src="photos/94bgc1_s.jpg" border="0" width="200"      
        height="142"></a></td>      
        <td bgcolor="#FFFFFF">悲喜交々のラウンド後（笑）<p>カップを持っているのは誰？　</p>      
        </td>      
    </tr>      
</table>      
</center></div>      
      
<p><a href="mainfield.htm" target="contents4">←戻る</a></p>  
  
<p>　</p>  
  
<hr width="90%">  
  
<p><a name="第７回"></a>　</p>
<div align="center"><center>

<table border="2">
    <caption align="top"><font size="5">第７回（’９８）　於     
    太平洋クラブ軽井沢コース</font></caption>     
    <tr>     
        <td align="center" colspan="2" bgcolor="#C0C0C0">アフターゴルフならぬプレゴルフ</td>     
    </tr>     
    <tr>     
        <td align="center" colspan="2" bgcolor="#FFFFFF"><a     
        href="photos/98bgc0.jpg"><img src="photos/98bgc0_s.jpg"     
        border="0" width="200" height="136"></a></td>     
    </tr>     
    <tr>     
        <td align="center" colspan="2" bgcolor="#FFFFFF">やっぱり、これがなくちゃね（笑）。前哨戦を征したのは．．．</td>     
    </tr>     
    <tr>     
        <td align="center" colspan="2" bgcolor="#C0C0C0">年に１回の公式戦スタート</td>     
    </tr>     
    <tr>     
        <td align="center" valign="bottom" bgcolor="#FFFFFF"><a     
        href="photos/98bgc2.jpg"><img src="photos/98bgc2_s.jpg"     
        border="0" width="200" height="141"></a></td>     
        <td align="center" bgcolor="#FFFFFF"><a     
        href="photos/98bgc1.jpg"><img src="photos/98bgc1_s.jpg"     
        border="0" width="200" height="140"></a></td>     
    </tr>     
    <tr>     
        <td align="center" bgcolor="#FFFFFF">第１組、スタート前に「ハイチーズ」</td>     
        <td align="center" bgcolor="#FFFFFF">第２組も「ハイチーズ」</td>     
    </tr>     
    <tr>     
        <td align="center" bgcolor="#FFFFFF"><a     
        href="photos/98bgc3.jpg"><img src="photos/98bgc3_s.jpg"     
        border="0" width="138" height="200"></a></td>     
        <td align="center" bgcolor="#FFFFFF"><a     
        href="photos/98bgc4.jpg"><img src="photos/98bgc4_s.jpg"     
        border="0" width="137" height="200"></a></td>     
    </tr>     
    <tr>     
        <td align="center" colspan="2" bgcolor="#FFFFFF">　     
        みんな決まってるね。「ナイスショット！」</td>     
    </tr>     
    <tr>     
        <td align="center" bgcolor="#FFFFFF"><a     
        href="photos/98bgc6.jpg"><img src="photos/98bgc6_s.jpg"     
        border="0" width="139" height="200"></a></td>     
        <td align="center" bgcolor="#FFFFFF"><a     
        href="photos/98bgc5.jpg"><img src="photos/98bgc5_s.jpg"     
        border="0" width="200" height="136"></a></td>     
    </tr>     
    <tr>     
        <td align="center" colspan="2" bgcolor="#FFFFFF">こっちの二人は力が入ってませんか？（笑）</td>     
    </tr>     
    <tr>     
        <td align="center" bgcolor="#FFFFFF"><a     
        href="photos/98bgc7.jpg"><img src="photos/98bgc7_s.jpg"     
        border="0" width="200" height="139"></a></td>     
        <td align="center" bgcolor="#FFFFFF"><a     
        href="photos/98bgc8.jpg"><img src="photos/98bgc8_s.jpg"     
        border="0" width="200" height="141"></a></td>     
    </tr>     
    <tr>     
        <td align="center" bgcolor="#FFFFFF">ハーフ後の途中結果。順位は左からだっけ？</td>     
        <td align="center" bgcolor="#FFFFFF">「後半は頑張るぞ！」と意気揚揚</td>     
    </tr>     
    <tr>     
        <td align="center" bgcolor="#FFFFFF"><a     
        href="photos/98bgc9.jpg"><img src="photos/98bgc9_s.jpg"     
        border="0" width="200" height="141"></a></td>     
        <td align="center" bgcolor="#FFFFFF"><a     
        href="photos/98bgc10.jpg"><img src="photos/98bgc10_s.jpg"     
        border="0" width="200" height="141"></a></td>     
    </tr>     
    <tr>     
        <td align="center" bgcolor="#FFFFFF">ラウンド後の結果。位置が変ったのは誰？</td>     
        <td align="center" bgcolor="#FFFFFF">二人でドラコン＆ニアピン総奪</td>     
    </tr>     
    <tr>     
        <td align="center" colspan="2" bgcolor="#FF0000">結果発表</td>     
    </tr>     
    <tr>     
        <td align="center" bgcolor="#FFFFFF">　<a    
        href="photos/98bgc11.jpg"><img src="photos/98bgc11_s.jpg"    
        border="0" width="200" height="143"></a> </td>    
        <td align="center" bgcolor="#FFFFFF"><a    
        href="photos/98bgc12.jpg"><img src="photos/98bgc12_s.jpg"    
        border="0" width="200" height="138"></a>　 </td>    
    </tr>    
    <tr>    
        <td align="center" colspan="2" bgcolor="#FFFFFF">前年度優勝の二人からカップの贈呈。Ｖ２で笑顔だね</td>    
    </tr>    
    <tr>    
        <td align="center" bgcolor="#FFFFFF"><a    
        href="photos/98bgc13.jpg"><img src="photos/98bgc13_s.jpg"    
        border="0" width="200" height="136"></a>　 </td>    
        <td align="center" bgcolor="#FFFFFF"><a    
        href="photos/98bgc14.jpg"><img src="photos/98bgc14_s.jpg"    
        border="0" width="200" height="139"></a>　 </td>    
    </tr>    
    <tr>    
        <td align="center" bgcolor="#FFFFFF">今回も上位の準優勝。さすが</td>    
        <td align="center" bgcolor="#FFFFFF">惜しい。優勝までは後一歩</td>    
    </tr>    
    <tr>    
        <td align="center" bgcolor="#FFFFFF"><a    
        href="photos/98bgc16.jpg"><img src="photos/98bgc16_s.jpg"    
        border="0" width="200" height="137"></a></td>    
        <td align="center" bgcolor="#FFFFFF"><a    
        href="photos/98bgc15.jpg"><img src="photos/98bgc15_s.jpg"    
        border="0" width="200" height="139"></a></td>    
    </tr>    
    <tr>    
        <td align="center" bgcolor="#FFFFFF">４～６位の３人。</td>    
        <td align="center" bgcolor="#FFFFFF">次回のリベンジが恐い二人</td>    
    </tr>    
    <tr>    
        <td align="center" colspan="2" bgcolor="#FFFFFF"><a    
        href="photos/98bgc17.jpg"><img src="photos/98bgc17_s.jpg"    
        border="0" width="200" height="138"></a></td>    
    </tr>    
    <tr>    
        <td align="center" colspan="2" bgcolor="#FFFFFF">ドラコン＆ニアピン総奪の二人はやはり上位でご機嫌</td>    
    </tr>    
    <tr>    
        <td align="center" colspan="2" bgcolor="#FF00FF">お疲れ様</td>    
    </tr>    
    <tr>    
        <td align="center" colspan="2" bgcolor="#FFFFFF"><a    
        href="photos/98bgc18.jpg"><img src="photos/98bgc18_s.jpg"    
        border="0" width="200" height="139"></a></td>    
    </tr>    
    <tr>    
        <td align="center" colspan="2" bgcolor="#FFFFFF">来年もまた皆に会えることを願いつつ、「ハイチーズ！」</td>    
    </tr>    
</table>    
</center></div>    
    
<p><a href="mainfield.htm" target="contents4">←戻る</a></p>

<hr width="90%">
</body>
</html>
